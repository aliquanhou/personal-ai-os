# Personal AI OS — Git Attributes
# Auto-convert line endings: LF in repo, native on checkout

* text=auto

# Source code — LF in repo
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
